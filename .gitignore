# 原始資料不上傳 main 分支（資料是存在另一個 data 分支）
data/raw/*
!data/raw/.gitkeep
data/processed/

# data 分支用 git worktree 展開的位置（內容屬於 data 分支，不屬於 main）
data-branch/

